<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices below API 31.
   Backend API tokens live in hreader_prefs and must not leave the device. The cache holds nothing
   the server cannot rebuild, so it is excluded rather than shipped to cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="hreader_prefs.xml" />
    <exclude domain="database" path="hreader-db" />
    <exclude domain="file" path="article_images" />
</full-backup-content>
