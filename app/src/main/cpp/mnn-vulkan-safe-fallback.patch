diff --git a/source/backend/vulkan/runtime/vulkan_wrapper.cpp b/source/backend/vulkan/runtime/vulkan_wrapper.cpp
index fe1e9c4..8d01bfe 100644
--- a/source/backend/vulkan/runtime/vulkan_wrapper.cpp
+++ b/source/backend/vulkan/runtime/vulkan_wrapper.cpp
@@ -15,2 +15,23 @@
 #include "backend/vulkan/vulkan/vulkan_wrapper.h"
+#include <atomic>
+
+namespace {
+std::atomic<int> gMnnVulkanError{VK_SUCCESS};
+}
+
+void MNNVulkanResetError(void) {
+    gMnnVulkanError.store(VK_SUCCESS, std::memory_order_relaxed);
+}
+
+bool MNNVulkanHasError(void) {
+    return gMnnVulkanError.load(std::memory_order_relaxed) != VK_SUCCESS;
+}
+
+void MNNVulkanRecordError(VkResult result, const char* expression, const char* file, int line) {
+    int expected = VK_SUCCESS;
+    gMnnVulkanError.compare_exchange_strong(expected, static_cast<int>(result), std::memory_order_relaxed);
+    MNN_ERROR("Vulkan call failed: result=%d expression=%s location=%s:%d\n", static_cast<int>(result), expression,
+              file, line);
+}
+
 #ifndef MNN_USE_LIB_WRAPPER
